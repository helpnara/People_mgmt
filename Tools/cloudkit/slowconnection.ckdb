        CD_uuid_ckAsset ASSET,
        CD_since TIMESTAMP,
        CD_createdAt TIMESTAMP,
        CD_first STRING,
        CD_second STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CDMR (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_moveReceipt  BYTES,
        CD_moveReceipt_ckAsset ASSET,
        CD_entityNames STRING,
        CD_entityNames_ckAsset ASSET,
        CD_recordNames STRING,
        CD_recordNames_ckAsset ASSET,
        CD_relationships STRING,
        CD_relationships_ckAsset ASSET,
        GRANT WRITE TO "_creator",
