        CD_firstMetDate TIMESTAMP,
        CD_firstMetPrecision INT64,
        CD_firstNote STRING,
        CD_firstNote_ckAsset ASSET,
        CD_contactNote STRING,
        CD_contactNote_ckAsset ASSET,
        CD_mobilePhone STRING,
        CD_mobilePhone_ckAsset ASSET,
        CD_officePhone STRING,
        CD_officePhone_ckAsset ASSET,
        CD_faxNumber STRING,
        CD_faxNumber_ckAsset ASSET,
        CD_email STRING,
        CD_email_ckAsset ASSET,
        CD_isMe INT64,
        CD_tags BYTES,
        CD_tags_ckAsset ASSET,
        CD_createdAt TIMESTAMP,
        CD_updatedAt TIMESTAMP,
        CD_businessCard BYTES,
        CD_businessCard_ckAsset ASSET,
        CD_photo BYTES,
        CD_photo_ckAsset ASSET,
        CD_birthMonth INT64,
        CD_birthDay INT64,
        CD_birthYear INT64,
        CD_contactCadenceMonths INT64,
        CD_muteBirthdayReminder INT64,
        CD_keyNote STRING,
        CD_keyNote_ckAsset ASSET,
        CD_isPinned INT64,
        CD_introducedBy STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_Record (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
