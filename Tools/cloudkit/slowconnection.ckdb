        CD_name STRING,
        CD_name_ckAsset ASSET,
        CD_memberIDs BYTES,
        CD_memberIDs_ckAsset ASSET,
        CD_updatedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_Person (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
