        CD_moveReceipt_ckAsset ASSET,
        CD_uuid STRING,
        CD_uuid_ckAsset ASSET,
        CD_name STRING,
        CD_name_ckAsset ASSET,
        CD_nickname STRING,
        CD_nickname_ckAsset ASSET,
        CD_photoReference STRING,
        CD_photoReference_ckAsset ASSET,
        CD_organization STRING,
        CD_organization_ckAsset ASSET,
        CD_role STRING,
