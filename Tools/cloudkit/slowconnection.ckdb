DEFINE SCHEMA

    RECORD TYPE CD_Person (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_moveReceipt  BYTES,
        CD_moveReceipt_ckAsset ASSET,
        CD_uuid STRING,
        CD_uuid_ckAsset ASSET,
        CD_name STRING,
        CD_name_ckAsset ASSET,
        CD_nickname STRING,
        CD_nickname_ckAsset ASSET,
        CD_photoReference STRING,
        CD_photoReference_ckAsset ASSET,
        CD_organization STRING,
        CD_organization_ckAsset ASSET,
        CD_role STRING,
        CD_role_ckAsset ASSET,
        CD_relationshipType STRING,
        CD_relationshipType_ckAsset ASSET,
        CD_metThrough STRING,
        CD_metThrough_ckAsset ASSET,
        CD_firstMetDate TIMESTAMP,
        CD_firstMetPrecision INT64,
        CD_firstNote STRING,
        CD_firstNote_ckAsset ASSET,
        CD_contactNote STRING,
        CD_contactNote_ckAsset ASSET,
        CD_mobilePhone STRING,
        CD_mobilePhone_ckAsset ASSET,
        CD_officePhone STRING,
        CD_officePhone_ckAsset ASSET,
        CD_faxNumber STRING,
        CD_faxNumber_ckAsset ASSET,
        CD_email STRING,
        CD_email_ckAsset ASSET,
        CD_isMe INT64,
        CD_tags BYTES,
        CD_tags_ckAsset ASSET,
        CD_createdAt TIMESTAMP,
        CD_updatedAt TIMESTAMP,
        CD_businessCard BYTES,
        CD_businessCard_ckAsset ASSET,
        CD_photo BYTES,
        CD_photo_ckAsset ASSET,
        CD_birthMonth INT64,
        CD_birthDay INT64,
        CD_birthYear INT64,
        CD_contactCadenceMonths INT64,
        CD_introducedBy STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_Record (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_moveReceipt  BYTES,
        CD_moveReceipt_ckAsset ASSET,
        CD_uuid STRING,
        CD_uuid_ckAsset ASSET,
        CD_title STRING,
        CD_title_ckAsset ASSET,
        CD_recordType STRING,
        CD_recordType_ckAsset ASSET,
        CD_occurredAt TIMESTAMP,
        CD_occurredPrecision INT64,
        CD_location STRING,
        CD_location_ckAsset ASSET,
        CD_note STRING,
        CD_note_ckAsset ASSET,
        CD_tags BYTES,
        CD_tags_ckAsset ASSET,
        CD_createdAt TIMESTAMP,
        CD_updatedAt TIMESTAMP,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CD_Tie (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_moveReceipt  BYTES,
        CD_moveReceipt_ckAsset ASSET,
        CD_uuid STRING,
        CD_uuid_ckAsset ASSET,
        CD_since TIMESTAMP,
        CD_createdAt TIMESTAMP,
        CD_first STRING,
        CD_second STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

    RECORD TYPE CDMR (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        CD_entityName   STRING,
        CD_moveReceipt  BYTES,
        CD_moveReceipt_ckAsset ASSET,
        CD_entityNames STRING,
        CD_entityNames_ckAsset ASSET,
        CD_recordNames STRING,
        CD_recordNames_ckAsset ASSET,
        CD_relationships STRING,
        CD_relationships_ckAsset ASSET,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_creator",
        GRANT READ TO "_creator"
    );

